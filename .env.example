# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# 32+ random characters used to sign admin sessions
AUTH_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_ while testing, sk_live_ to go live.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Public URL of the site (used for Stripe redirects). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=
# Restaurant's local time zone for "today" stats and times
NEXT_PUBLIC_RESTAURANT_TIMEZONE=America/Chicago
# Name shown in the browser tab / home-screen app
NEXT_PUBLIC_RESTAURANT_NAME=Saltbox Kitchen

# Optional: Vercel Blob token so staff can upload food photos
BLOB_READ_WRITE_TOKEN=
